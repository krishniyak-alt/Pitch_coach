# Django Environment Variables
DEBUG=True
SECRET_KEY=django-insecure-pitchcoach-local-dev-secret-key-change-in-prod
ALLOWED_HOSTS=localhost,127.0.0.1,0.0.0.0,.onrender.com

# Local MySQL Database Settings
DB_NAME=pitchcoach_db
DB_USER=root
DB_PASSWORD=
DB_HOST=127.0.0.1
DB_PORT=3306

# Set to True if you want to test with SQLite instead of MySQL
USE_SQLITE=False

# Google Gemini API Key for Judge Feedback & Rubric Scoring
GEMINI_API_KEY=

# Render Production Database URL (Optional on Render: external MySQL or PostgreSQL)
# DATABASE_URL=mysql://user:password@host:3306/dbname
